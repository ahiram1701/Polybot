MODE=sim
ENABLED_MARKETS=BTC
ENABLED_BTC_UP=
ENABLED_BTC_DOWN=
ENABLED_ETH_UP=
ENABLED_ETH_DOWN=
ENABLED_DOGE_UP=
ENABLED_DOGE_DOWN=
MIN_BTC_DISTANCE_USD=20
MIN_ETH_DISTANCE_USD=5
MIN_DOGE_DISTANCE_USD=0.0005
MIN_BTC_UP_DISTANCE_USD=
MIN_BTC_DOWN_DISTANCE_USD=
MIN_ETH_UP_DISTANCE_USD=
MIN_ETH_DOWN_DISTANCE_USD=
MIN_DOGE_UP_DISTANCE_USD=
MIN_DOGE_DOWN_DISTANCE_USD=
# Se cuenta desde el CIERRE: 120 = "no entres en los primeros 3 minutos". La ventana efectiva es
# (10, 120], porque DEFAULT_MIN_SECONDS_TO_END corta la cola y no es configurable.
#
# ES EL AJUSTE QUE MAS PESA. Medido el 2026-09-07 sobre las 1.098 operaciones del ledger con resultado
# conocido, agrupadas por los segundos que le quedaban a la ventana al comprar:
#
#   segundos al cierre    n     aciertos   equilibrio   ventaja
#         0 a  60         85     90,6%       84,8%      +5,83 pp
#        60 a 100        223     86,1%       84,9%      +1,21 pp
#       100 a 140        367     85,0%       85,1%      -0,07 pp
#       140 a 300        423     81,1%       85,8%      -4,71 pp   <- significativo (t=-2,48)
#
# El agregado CAMBIA DE SIGNO al recortar: con 150 son -5,85$ por cada 100 operaciones de 5$; con 120,
# +2,71$; con 100, +12,47$. Con la ventana abierta el bot compraba en cuanto el ask entraba en banda,
# o sea con 2:30 por delante para que el precio se diera la vuelta.
#
# Lo SOLIDO es el lado negativo: no pasar de 140. Que entrar muy tarde sea tan bueno esta sugerido y no
# probado, y 120 cae en un bache de la serie (140 da +1,09 y 100 da +2,48). Recortar cuesta volumen, y
# el volumen es muestra: 120 deja el 45% de las operaciones, 100 el 28%, 60 el 8%.
#
# 2026-09-11 — para el FAVORITO, 50 s y SIN filtro de certeza. Los 80 s con z>=1,5 del dia 8 fueron un
# sobreajuste: hacia delante perdio (49 entradas, 83,7% de acierto contra 88,0% de equilibrio). Con 6
# tramos cronologicos y bootstrap por ventanas (`npx tsx src/smoke/favoritoReplay.ts`), 50 s sin
# certeza y banda 0,79-0,88 es positiva en los 6 tramos (peor +2,42 pp, +4,49 pp de media, 84 entradas
# al dia), mientras que la del dia 8 solo lo es en 4. Se elige por el PEOR tramo, nunca por el neto
# medio. Este numero y FAVORITE_MIN_CERTAINTY se mueven JUNTOS o no se mueven.
ENTRY_WINDOW_SECONDS=50
ENTRY_WINDOW_SECONDS_BTC=
ENTRY_WINDOW_SECONDS_ETH=
ENTRY_WINDOW_SECONDS_DOGE=
ENTRY_WINDOW_SECONDS_BTC_UP=
ENTRY_WINDOW_SECONDS_BTC_DOWN=
ENTRY_WINDOW_SECONDS_ETH_UP=
ENTRY_WINDOW_SECONDS_ETH_DOWN=
ENTRY_WINDOW_SECONDS_DOGE_UP=
ENTRY_WINDOW_SECONDS_DOGE_DOWN=
SIM_TRADE_AMOUNT_USD=1
SIM_TRADE_AMOUNT_USD_BTC_UP=
SIM_TRADE_AMOUNT_USD_BTC_DOWN=
SIM_TRADE_AMOUNT_USD_ETH_UP=
SIM_TRADE_AMOUNT_USD_ETH_DOWN=
SIM_TRADE_AMOUNT_USD_DOGE_UP=
SIM_TRADE_AMOUNT_USD_DOGE_DOWN=
LIVE_TRADE_AMOUNT_USD=1
LIVE_TRADE_AMOUNT_USD_BTC_UP=
LIVE_TRADE_AMOUNT_USD_BTC_DOWN=
LIVE_TRADE_AMOUNT_USD_ETH_UP=
LIVE_TRADE_AMOUNT_USD_ETH_DOWN=
LIVE_TRADE_AMOUNT_USD_DOGE_UP=
LIVE_TRADE_AMOUNT_USD_DOGE_DOWN=
AUTO_MIN_LIVE=true
MAX_ASK_PRICE=0.98
MAX_ASK_PRICE_BTC_UP=
MAX_ASK_PRICE_BTC_DOWN=
MAX_ASK_PRICE_ETH_UP=
MAX_ASK_PRICE_ETH_DOWN=
MAX_ASK_PRICE_DOGE_UP=
MAX_ASK_PRICE_DOGE_DOWN=

# --- Limites de gasto y de perdida ---------------------------------------------------------------
#
# OJO CON LOS DOS QUE VIENEN EN 0. `MAX_DAILY_LOSS_USD` y `MAX_CONSECUTIVE_LOSSES` valen 0 por
# defecto, y 0 significa DESACTIVADO, no "sin tolerancia": `evaluateRiskCircuitBreaker` exige > 0 para
# actuar, asi que de fabrica el cortacircuitos NO PUEDE DISPARARSE NUNCA. Con dinero real hay que
# ponerles un numero que de verdad pueda saltar.
#
# `DAILY_SPEND_LIMIT_USD` acota lo que se GASTA al dia, no lo que se pierde: son cosas distintas.
#
# 2026-09-20: los frenos por PERDIDA se quedan apagados y lo que se enciende es el objetivo del dia.
# El freno por racha estuvo puesto unas horas el 19 y se quito: acotaba la caida del acumulado, que no
# es el problema que se queria resolver.
#
# `DAILY_PROFIT_TARGET_USD` es el unico limite que para por ir BIEN: cuando lo GANADO hoy lo alcanza,
# se deja de entrar hasta mañana. El motivo, medido dia a dia con `npx tsx src/smoke/cerrarEnVerde.ts`:
# ningun dia conservaba su maximo. El 14 llego a +25,42 $ y cerro en +11,62 $; el 17 llego a +4,06 $ y
# cerro en -20,11 $; 4 de 9 dias cerraron en rojo y 3 de ellos habian estado en verde.
#
# LO QUE NO HACE, y esta medido: no sube la ganancia esperada. Si cada entrada tiene ventaja, dejar de
# entrar cuando vas ganando quita entradas buenas — en el periodo de eleccion el objetivo de 15 $
# cuesta un 16% del neto. Lo que compra es regularidad. Tampoco salva un dia que nunca sube: para eso
# esta `MAX_DAILY_LOSS_USD`, que es el otro lado y sigue en 0.
DAILY_SPEND_LIMIT_USD=10000
MAX_DAILY_LOSS_USD=0
MAX_CONSECUTIVE_LOSSES=0
# 15 $ es el punto elegido de una frontera que es monotona en los dos periodos: cuanto mas bajo el
# objetivo, mas dias cierran en verde y menos dinero se hace. Con 15 $, en el periodo de juicio cierra
# 6 de 9 dias en verde con +45,42 $ (la config anterior hacia 5 de 9 con +30,18 $); con 3 $ cerraria
# 8 de 9 pero a +1,95 $ al dia. 0 = desactivado.
DAILY_PROFIT_TARGET_USD=15
# Horas que dura el freno tras saltar; luego se re-arma solo con la cuenta a cero. 0 = parado el resto
# del dia, que castigaba con ~23 h un salto a las 00:30 y con 10 minutos uno a las 23:50.
#
# NO afecta al objetivo del dia: un objetivo cumplido dura hasta el corte del dia, se ponga lo que se
# ponga aqui. Rearmarlo a las dos horas seria lo contrario de asegurar lo ganado.
RISK_HALT_COOLDOWN_HOURS=2

# --- Capital ---------------------------------------------------------------------------------------
#
# `LIVE_BANKROLL_USD` es el saldo DECLARADO: solo se usa cuando la lectura on-chain falla o caduca (5
# min). Dejarlo en 0 hace que el arbitraje se salte con `arb_bankroll_unknown` en vez de dimensionar a
# ciegas, que es lo correcto — pero si operas en live conviene ponerlo algo POR DEBAJO de tu saldo real.
LIVE_BANKROLL_USD=0
# Apaga el direccional EN LIVE mientras el capital real este por debajo.
#
# BAJADO DE 50 A 10 el 2026-09-03 por decision explicita, para poder operar con $12 de capital. La
# simulacion de ruina NO respalda este valor: con $10, y asumiendo un edge GANADOR (83% de aciertos,
# +4,3% ROI/operacion), la probabilidad de quedarse sin poder operar en un mes es del 67,6%. Con 50
# baja al 4,8%.
#
# Ojo con la aritmetica: la guardia mide el colateral LIBRE, y una orden de $5 lo baja en el acto. Con
# $12 y la guardia en $10, la primera entrada deja $7 y la guardia se cierra hasta que esa posicion
# resuelva GANANDO. A ese capital el direccional opera de una en una, y una perdida lo bloquea.
MIN_BANKROLL_FOR_DIRECTIONAL_USD=10

TICK_STALE_MS=10000
POLL_INTERVAL_MS=1000
POLYGON_RPC_URL=https://polygon-rpc.com
OLLAMA_API_KEY=
OLLAMA_HOST=https://ollama.com
OLLAMA_MODEL=gpt-oss:120b
POLYBOT_UI_HOST=127.0.0.1
POLYBOT_UI_PORT=8787
POLYBOT_PUBLIC_URL=

# Optional Telegram notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Required only for --mode live --confirm-live
POLYMARKET_PRIVATE_KEY=
POLYMARKET_SIGNATURE_TYPE=0
POLYMARKET_FUNDER_ADDRESS=

# --- Ventana de ask BASE del auto-ajuste ----------------------------------------------------------
#
# NO es "donde operar": es el LIMITE EXTERIOR que el tuner nunca puede rebasar, y su referencia fija
# (nunca la escribe). El tuner solo ESTRECHA desde aqui, y solo pasando bandas que perdieron dinero con
# muestra suficiente — nunca por ausencia de evidencia.
#
# Los valores replican los defaults del codigo (`src/config.ts`, ASK_WINDOW_BASELINE_MIN/MAX = 0.01 y
# 0.70). Este fichero llego a decir 0.65-0.96 con un razonamiento propio que contradecia al codigo:
# quien copiara el ejemplo tal cual movia la base sin saberlo, y unos limites mal puestos aqui ya
# mataron el tuner una vez.
#
# El porque de estos numeros, resumido del comentario que manda (`src/config.ts`):
#
#   - Ancha a proposito, para que el tuner APRENDA cada borde en vez de heredar uno elegido a mano: la
#     banda barata gana +$123,60 en BTC y pierde -$116,27 en ETH, asi que un mismo suelo para los dos
#     es forzosamente el equivocado para uno.
#   - Techo en 0,70 y no en 0,98, porque la zona de 0,98 hizo 225 operaciones para ganar $8,68.
#     MAX_ASK_PRICE_CEILING sigue por encima como red.
#   - Ambos son BORDES DE BANDA (0.45/0.55/0.65/0.70/0.75/0.80). Una base a media banda dejaria esa
#     banda permanentemente inevaluable y el tuner quedaria ciego justo donde ETH sangra.
ASK_WINDOW_BASELINE_MIN=0.01
ASK_WINDOW_BASELINE_MAX=0.70

# --- Techos y pisos de precio ---------------------------------------------------------------------
# Techo DURO: ni una operacion ni el autoajuste pueden pasar de aqui.
MAX_ASK_PRICE_CEILING=0.85
MIN_ASK_PRICE=0.01
# Cuanto por encima del best-ask puede llenar una orden live (anti-slippage).
LIVE_MAX_SLIPPAGE=0.02
# Descarta la operacion si el libro solo puede llenar menos de esta fraccion del monto pedido.
MIN_FILL_RATIO=0.5

# --- Estrategia "favorito" ------------------------------------------------------------------------
# Compra el lado que el LIBRO ya declara ganador cuando su ask entra en la banda. No predice nada:
# replica la operativa manual de "me subo al que va ganando". SUSTITUYE a la seleccion direccional
# (distancia de Chainlink) cuando esta encendida; las dos no operan a la vez a proposito, para que
# cada muestra del ledger pertenezca a una sola estrategia.
#
# Viene APAGADA, y con motivo: la banda 0,76-0,85 esta dentro de la zona de favoritos caros, y esa
# zona ya se midio aqui — 225 operaciones para ganar $8,68. Enciendela en SIM y deja que acumule
# muestras propias antes de plantearte nada mas.
FAVORITE_STRATEGY_ENABLED=false
# Banda medida el 2026-09-11 con 6 tramos cronologicos (`npx tsx src/smoke/favoritoReplay.ts`): a 50 s,
# 0,79-0,88 es positiva en los 6. El tramo 0,88-0,90 pierde -1,77 pp a 80 s (n=461).
#
# AL ENCENDER EL FAVORITO, SUBE MAX_ASK_PRICE_CEILING A 0,88 O MAS (arriba viene en 0,85 por el camino
# direccional). El techo duro se aplica DESPUES del selector: con 0,85, las entradas entre 0,85 y 0,88 se
# eligen en banda y se descartan despues sin decir por que, y eso parece un fallo del selector.
FAVORITE_MIN_ASK=0.79
FAVORITE_MAX_ASK=0.88
# Tope de la SUMA de los dos asks. Por encima el libro esta muerto: los dos "mejores asks" son ofertas
# anchas y sueltas, y entonces un 0,80 no significa "80% de probabilidad", significa que no hay mercado.
FAVORITE_MAX_ASK_SUM=1.15
# Certeza MINIMA para entrar: cuantos movimientos tipicos del precio harian falta EN CONTRA para dar
# la vuelta a la ventana. Es la diferencia entre "el libro dice que este lado va ganando" y "esto ya
# esta decidido".
#
#   z = distancia al strike / (volatilidad por segundo x raiz de los segundos que quedan)
#
# OJO CON LAS DOS TABLAS VIEJAS. Primero fue 1, con una tabla de 1.484 ventanas "aguantando hasta el
# cierre", que medía otro universo. Luego 1,5, junto con una ventana de 80 s, elegido por el neto medio
# dentro de muestra, y hacia delante perdio. Las dos veces el error fue el mismo: elegir con una medida
# que premia la suerte.
#
# Desde 2026-09-11 va APAGADO (-1000), con la ventana de entrada en 50 s. Con 6 tramos cronologicos y
# bootstrap por ventanas (`npx tsx src/smoke/favoritoReplay.ts`), 50 s sin certeza y banda 0,79-0,88 es
# positiva en los 6 tramos. A 50 s del cierre el ask ya descuenta lo decidida que esta la ventana, y
# z>=1 deja tan pocas operaciones (80 en 7,8 dias) que no compite. -1000 y no -Infinity porque el
# esquema no tiene minimo y JSON no admite infinitos. Se mueve JUNTO con ENTRY_WINDOW_SECONDS o no se
# mueve.
FAVORITE_MIN_CERTAINTY=-1000
# Cierre APARTE para dinero real. Con FAVORITE_STRATEGY_ENABLED=true y esto en false, el camino
# direccional se PARA en live — no vuelve al criterio antiguo por su cuenta.
FAVORITE_ALLOW_LIVE=false
# Tramo de MAXIMA CONVICCION: por encima de FAVORITE_MAX_SIZE_ASK el importe deja de ser el
# configurado y se dimensiona contra el saldo REAL de la cuenta (necesita POLYMARKET_FUNDER_ADDRESS
# para leerlo on-chain). Interruptor propio y apagado: multiplica el tamaño de la posicion.
#
# Medido sobre sus 28 operaciones (2026-09-07), y el resultado es aritmetica, no mala racha:
#
#   aciertos 96,4%  |  ask medio 0,989  |  ROI -2,23%
#   ganancia media por acierto ...  +0,066 $
#   perdida  media por fallo .....  -5,564 $   ->  un fallo se come 85 aciertos
#   necesitas acertar 98,94%       ->  aciertas 96,4%
#
# Es el tramo con MEJOR tasa de acierto de todo el bot y aun asi pierde: a 0,99 el mercado ya se quedo
# todo el premio, y no queda margen para equivocarse ni una vez. Lo peligroso no es el ROI sino el
# TAMAÑO — apuesta una fraccion del capital libre en UNA entrada, asi que el fallo llega de golpe.
FAVORITE_MAX_SIZE_ENABLED=false
FAVORITE_MAX_SIZE_ASK=0.98
# Que FRACCION del capital libre se juega ese tramo. La mitad por defecto, no todo: a 0,98 el propio
# mercado dice que se equivoca una de cada cincuenta veces, y con la cuenta entera esa una no deja
# con que seguir. Lo que no se juega aqui no queda ocioso — la banda comprueba capital libre antes de
# entrar, asi que vuelve a estar disponible para las entradas normales. 1 = el all-in de antes.
FAVORITE_MAX_SIZE_FRACTION=0.5

# --- Salida por stop (acotar la perdida) ----------------------------------------------------------
# Abre el PRIMER camino de VENTA del bot: hasta aqui toda posicion se mantenia hasta la redencion, asi
# que no hay ni una venta en el historial contra la que comparar. Viene APAGADA.
#
# Cuando el ask del lado que se tiene cae por debajo del suelo de la banda de compra (FAVORITE_MIN_ASK
# menos el margen de abajo), la posicion se vende y el favorito puede volver a entrar en la misma
# ventana si el nuevo lado pasa los filtros de siempre. Solo aplica al favorito y exige
# FAVORITE_STRATEGY_ENABLED: son sus libros los que alimentan la decision.
#
# OJO con el coste: el stop mira el ASK —la misma vara con la que se decidio entrar— pero al vender se
# cobra el BID, dos o tres centimos mas abajo, y encima se paga comision. Cada rebalanceo paga el ancho
# del libro DOS veces (bid al vender, ask al recomprar) y gasta del limite diario las dos veces, porque
# DAILY_SPEND_LIMIT_USD mide gasto BRUTO y no se reembolsa. Con las reentradas sin limite, ese contador
# es el unico techo que queda: bajalo antes de encender esto.
# 2026-09-11 — se deja APAGADA despues de medirla: ninguna variante mejora a aguantar. 156 salidas reales
# costaron -5,50 $ frente a aguantar, y el replay (`src/favoriteExitReplay.ts`) da -4,01 $. Cuando la
# certeza cae a cero el bid ya esta en ~0,20. Con la ventana de entrada en 50 s ni siquiera podria
# dispararse (10 s de permanencia y >= 45 s al cierre).
FAVORITE_EXIT_ENABLED=false
# El disparador que MANDA: se vende cuando la certeza cae a este valor o por debajo. Es la misma
# medida con la que se decide entrar (FAVORITE_MIN_CERTAINTY), o sea el ORACULO, no el libro.
#
# Sobre las 152 entradas de certeza alta del historico:
#
#   aguantar siempre             +0,4623 por operacion     0 ventas
#   vender con certeza <= 0      +0,5686                   9 ventas
#   vender con certeza <= 0,25   +0,5166                  14 ventas
#   vender con certeza <= 0,50   +0,4876                  19 ventas
#
# Cero: cuanto antes se vende, mas se paga el ancho del libro por ventanas que se habrian recuperado
# solas. En cero se vende solo cuando el precio ya esta al otro lado del strike.
FAVORITE_EXIT_CERTAINTY=0
# RED DE SEGURIDAD por precio, para el desplome que la certeza no vea venir. Inclusivo.
#
# Deliberadamente lejos de la banda de compra. Cuando ESTO era el disparador principal, la salida
# perdia dinero en todos los umbrales probados sobre 705 ventanas:
#
#   stop   salidas   a lados que ganaban   neto      vs no vender
#   0,79     373            264          -157,40      -105,22
#   0,70     250            144          -113,86       -61,67
#   0,60     191             87           -79,59       -27,41
#
# El ask baja dos centimos por ruido, se cobra el bid y se recompra mas caro. Por debajo de 0,35 el
# libro ya no discrepa del oraculo: lo confirma.
FAVORITE_EXIT_STOP_ASK=0.35
# Solo se usa si FAVORITE_EXIT_STOP_ASK no esta puesto: deriva el stop restando esto al suelo de la
# banda. Un centimo, no cero: con cero se venderia a un precio al que la estrategia todavia COMPRA.
FAVORITE_EXIT_STOP_MARGIN=0.01
# Al final de la ventana el CLOB rechaza ordenes taker, y sin tiempo no hay reentrada posible.
FAVORITE_EXIT_MIN_SECONDS=45
# Suelo del mejor bid: por debajo, vender no acota la perdida, la regala.
FAVORITE_EXIT_MIN_BID=0.05
# Fraccion de la posicion que los compradores deben absorber. Una venta parcial paga el spread entero
# y te deja la perdida encima.
FAVORITE_EXIT_MIN_FILL_RATIO=0.9
# Spread propio maximo para fiarse del ask. Con el libro anchisimo, un 0,70 no dice "ha caido al 70%":
# dice que no hay mercado.
FAVORITE_EXIT_MAX_SPREAD=0.1
# Cuanto debe vivir una posicion antes de poder venderse, para que la misma oscilacion del libro no
# produzca la compra Y la venta.
FAVORITE_EXIT_MIN_HOLD_SECONDS=10
# Cierre APARTE para vender de verdad. Sin el, la salida solo se simula. Este camino NUNCA ha tocado el
# exchange real, asi que el sim no puede haber validado el formato de la orden: la primera venta en
# live conviene hacerla con una posicion pequeña y leyendo la respuesta a mano.
FAVORITE_EXIT_ALLOW_LIVE=false

# --- Arbitraje de set completo --------------------------------------------------------------------
# Lo unico sin riesgo direccional: un par completo redime $1/set gane quien gane. Viene APAGADO.
# Recuerda que cada pata es una orden independiente y ambas deben superar los $5 del exchange.
ARB_ENABLED=false
ARB_MAX_USD_PER_OPPORTUNITY=25
ARB_MIN_NET_PER_SET=0.02

# --- Zona horaria y retencion ---------------------------------------------------------------------
# "auto" = la del sistema. Bajo Docker el contenedor va con TZ=UTC, asi que "auto" resuelve a UTC — que
# es lo que se quiere: las recompensas se abonan ~00:45 UTC y el corte del dia debe coincidir.
POLYBOT_TIMEZONE=auto
# Muestras de analytics.jsonl. Al llenarse, cada muestra nueva BORRA la mas vieja (~1 semana a
# 730/dia). Subirlo cuesta mucha memoria: a 20.000 la proyeccion es de 608 MB. Para acumular historia
# esta el archivador (docker compose lo corre cada 12 h), no este numero.
#
# 5.000 y no 10.000 desde el 2026-09-17: con 10.000 el fichero llego a 515 MB y cruzar los 512 MB que
# Node admite en una cadena dejaba la poda sin poder leer su propio fichero — un punto muerto que
# mantuvo al bot 7,5 h sin operar. La poda ya no construye esa cadena, pero el margen se queda.
MAX_ANALYTICS_SAMPLES=5000

# --- Endpoints ------------------------------------------------------------------------------------
GAMMA_HOST=https://gamma-api.polymarket.com
CLOB_HOST=https://clob.polymarket.com
RTDS_URL=wss://ws-live-data.polymarket.com

# --- MCP ------------------------------------------------------------------------------------------
# AMBOS VIENEN EN true. Con `POLYBOT_MCP_ALLOW_LIVE=true` un agente puede pedir modo live por MCP.
# Ponlos en false salvo que sepas exactamente por que los quieres abiertos.
POLYBOT_MCP_ALLOW_WRITE=true
POLYBOT_MCP_ALLOW_LIVE=true

# --- Supervisor -----------------------------------------------------------------------------------
# Quien relanza el proceso si muere: compose | windows-watchdog | systemd | ninguno.
# Lo fija docker-compose.yml; a mano solo hace falta si arrancas sin compose. La UI lo lee para no
# ofrecer el interruptor del watchdog de Windows donde no lo lee nadie.
POLYBOT_SUPERVISOR=windows-watchdog
